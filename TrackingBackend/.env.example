PORT=5000
MONGODB_URI=mongodb://localhost:27017/tracking_db
NODE_ENV=development

# Comma-separated list of production website origins allowed to call this
# API. Any http://localhost:PORT or http://127.0.0.1:PORT origin is always
# allowed automatically (that's a developer's own machine), so only real
# deployed domains need to be listed here. Add a new website's exact origin
# (no trailing slash) to onboard it - no code change needed.
# Example: ALLOWED_ORIGINS=https://drivecoveragenow.com,https://dashboard.drivecoveragenow.com
ALLOWED_ORIGINS=

# --- Dashboard login (see models/Admin.js, controllers/authController.js) ---
# Secret used to sign login tokens. MUST be a long random value in any real
# deployment - the insecure default in code is for local dev only.
JWT_SECRET=change-this-to-a-long-random-string

# Credentials for the default super admin, auto-created on first server start
# if no super admin exists yet. Log in with these, then use "Create Admin" in
# the dashboard to add scoped admins for specific websites.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
