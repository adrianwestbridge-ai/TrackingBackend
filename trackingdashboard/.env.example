# Backend API base URL (no trailing slash, no /sessions suffix).
# Leave unset for local dev - it falls back to http://localhost:5000/api.
# Set this in your hosting provider's dashboard (e.g. Cloudflare Pages ->
# Settings -> Environment variables) before deploying, then redeploy -
# Vite bakes this in at build time, so changing it later needs a rebuild.
VITE_API_URL=https://tracking-api.onrender.com/api
